# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — SIGAP-ASET (DISHUB DIY)
# Salin file ini menjadi '.env' di folder 'backend/' dan sesuaikan nilainya.
# PERINGATAN: JANGAN PERNAH MENYIMPAN KREDENSIAL ASLI KE DALAM FILE INI / GIT!
# ==============================================================================

# Port Server Backend
PORT=5000

# Konfigurasi Basis Data PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=siap
PGUSER=postgres
PGPASSWORD=your_postgres_password_here

# Kunci Rahasia JWT (JSON Web Token) untuk Autentikasi RBAC
# Gunakan string acak minimal 32 karakter untuk produksi
JWT_SECRET=your_jwt_secret_key_dishub_diy_random_hash

# ID Google Spreadsheet untuk Sinkronisasi Otomatis Cloud API
# Ambil dari URL Spreadsheet: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
