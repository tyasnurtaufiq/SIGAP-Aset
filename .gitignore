# ==============================================================================
# .gitignore — SISTEM INFORMASI GEOSPASIAL DAN PENGELOLAAN ASET (SIGAP-ASET)
# Dinas Perhubungan Daerah Istimewa Yogyakarta
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FILE SENSITIF, KREDENSIAL, & KEAMANAN (CRITICAL SECURITY)
# JANGAN PERNAH MENGHAPUS ATURAN INI AGAR KUNCI RAHASIA TIDAK BOCOR KE PUBLIK!
# ------------------------------------------------------------------------------
# Environment Variables (.env)
*.env
*.env.local
*.env.*.local
*.env.production
*.env.development
.env
backend/.env
frontend/.env
# Kecualikan file template contoh:
!*.env.example
!.env.example
!backend/.env.example

# Google Cloud Service Account & API Secrets
*service-account*.json
*client_secret*.json
credentials.json
token.json
service-account.json
backend/service-account.json
# Kecualikan file template contoh:
!service-account.example.json
!backend/service-account.example.json

# Sertifikat, Kunci Privat, & Token SSH / SSL
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Database Local Dumps & Backups
*.sql.gz
*.sql.bak
*.dump
backup/
backups/

# ------------------------------------------------------------------------------
# 2. FILE TIDAK TERPAKAI / AD-HOC / SCRATCHPAD / TEMPORARY
# ------------------------------------------------------------------------------
# Folder scratch untuk pengujian sementara dan skrip ad-hoc
scratch/
.system_generated/
.gemini/

# File tangkapan layar pengujian & file HTML ad-hoc lama
screen*.png
test_*.png
test_*.html
aspal.html

# Berkas sementara & swap
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 3. BERKAS DOKUMEN & DIAGRAM (TIDAK DIPERLUKAN OLEH RUNTIME SISTEM)
# Dokumen analisis, laporan, SOP, dan diagram hanya untuk keperluan dokumentasi
# offline dan tidak diperlukan untuk menjalankan aplikasi/kode program.
# ------------------------------------------------------------------------------
# Dokumen Analisis Kebutuhan Sistem (SRS), SOP, & Laporan
DOKUMEN_ANALISIS_KEBUTUHAN_SISTEM.*
Dokumen Analisis Kebutuhan Sistem.*
SOP_PENGELOLAAN_SIAP.*
sop_pengelolaan_siap.*
laporan_dokumentasi_siap.*
analysis_results.md
walkthrough.md

# Format Dokumen Perkantoran Umum
*.docx
*.doc
*.pdf
*.pptx
*.ppt

# Diagram Sistem & Berkas Vektor Hasil Render
# Catatan: Ikon UI aplikasi pada frontend/public/ dan frontend/src/assets/ tetap dilacak
activity_diagram_sigap.svg
erd_diagram_sigap.svg
usecase_diagram_sigap.svg
analisis_diagram_sigap.html
/*_diagram*.svg

# Kecualikan README utama agar tetap terlacak di repositori
!README.md
!backend/README.md
!frontend/README.md

# ------------------------------------------------------------------------------
# 4. DEPENDENSI & PACKAGE MANAGER (NODE.JS)
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Logs runtime & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# ------------------------------------------------------------------------------
# 4. HASIL BUILD & DISTRIBUSI (OUTPUT BUILD)
# ------------------------------------------------------------------------------
dist/
frontend/dist/
build/
out/
.output/
.vite/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. PYTHON CACHE & ARTIFAK (JIKA MENGGUNAKAN SKRIP GENERATOR)
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 6. PENGATURAN EDITOR & IDE
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 7. SISTEM OPERASI (OS JUNK)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory
